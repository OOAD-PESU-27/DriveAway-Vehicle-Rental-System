<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.*?>

<VBox spacing="14" alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.driveaway.controllers.RegisterController"
      style="-fx-background-color: #283593; -fx-padding: 40;">

    <Label text="🚗 DriveAway — Register"
           style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>

    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 24;
          -fx-background-radius: 12;
          -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 16, 0, 0, 4);">

        <Label text="Create Account" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #283593;"/>

        <Label text="Full Name:" style="-fx-font-weight: bold;"/>
        <TextField fx:id="nameField" promptText="Your full name"
                   style="-fx-font-size: 13px; -fx-padding: 8;"/>

        <Label text="Email:" style="-fx-font-weight: bold;"/>
        <TextField fx:id="emailField" promptText="email@example.com"
                   style="-fx-font-size: 13px; -fx-padding: 8;"/>

        <Label text="Password:" style="-fx-font-weight: bold;"/>
        <PasswordField fx:id="passwordField" promptText="Choose a password"
                       style="-fx-font-size: 13px; -fx-padding: 8;"/>

        <Label text="Phone:" style="-fx-font-weight: bold;"/>
        <TextField fx:id="phoneField" promptText="10-digit phone number"
                   style="-fx-font-size: 13px; -fx-padding: 8;"/>

        <Button text="Register →"
                onAction="#handleRegister"
                maxWidth="Infinity"
                style="-fx-background-color: #283593; -fx-text-fill: white;
                       -fx-font-size: 14px; -fx-font-weight: bold;
                       -fx-padding: 10; -fx-background-radius: 8; -fx-cursor: hand;"/>

        <Button text="Already have an account? Login"
                onAction="#goToLogin"
                maxWidth="Infinity"
                style="-fx-background-color: transparent; -fx-text-fill: #283593;
                       -fx-font-size: 13px; -fx-cursor: hand; -fx-border-color: #283593;
                       -fx-border-radius: 8; -fx-padding: 8;"/>
    </VBox>
</VBox>
