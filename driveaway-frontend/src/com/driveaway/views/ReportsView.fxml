<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.driveaway.controllers.ReportsController"
            stylesheets="@styles/main.css"
            styleClass="main-background">

    <top>
        <HBox styleClass="nav-bar" alignment="CENTER_LEFT" spacing="10">
            <VBox alignment="CENTER_LEFT">
                <Label text="🚗 DriveAway" styleClass="nav-logo"/>
                <Label text="Vehicle Rental System" styleClass="nav-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="🏠 Home" onAction="#goToDashboard" styleClass="nav-button"/>
            <Button text="🚘 Vehicles" onAction="#goToVehicles" styleClass="nav-button"/>
            <Button text="📅 Bookings" onAction="#goToBookings" styleClass="nav-button"/>
            <Button text="👤 Profile" onAction="#goToProfile" styleClass="nav-button"/>
            <Button text="🔔 Notifications" onAction="#goToNotifications" styleClass="nav-button"/>
            <Separator orientation="VERTICAL"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="nav-logout-button"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="24" style="-fx-padding: 28 32 28 32;">

                <!-- Page Header Banner -->
                <VBox styleClass="report-summary-banner" spacing="4">
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <Label text="📊" style="-fx-font-size: 36px;"/>
                        <VBox spacing="2">
                            <Label text="Reports &amp; Analytics" styleClass="report-summary-title"/>
                            <Label text="Generate and view detailed fleet, revenue and booking reports"
                                   styleClass="report-summary-sub"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="🔄 Refresh" onAction="#handleRefresh"
                                styleClass="btn-outline"
                                style="-fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.5);"/>
                    </HBox>
                </VBox>

                <!-- Summary Stat Cards Row -->
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <VBox styleClass="stat-card-blue" spacing="6" alignment="CENTER_LEFT"
                          HBox.hgrow="ALWAYS">
                        <Label text="🚘" style="-fx-font-size: 26px;"/>
                        <Label fx:id="totalVehiclesLabel" text="—" styleClass="stat-value-white"/>
                        <Label text="Total Vehicles" styleClass="stat-label-white"/>
                    </VBox>
                    <VBox styleClass="stat-card-green" spacing="6" alignment="CENTER_LEFT"
                          HBox.hgrow="ALWAYS">
                        <Label text="✅" style="-fx-font-size: 26px;"/>
                        <Label fx:id="availableVehiclesLabel" text="—" styleClass="stat-value-white"/>
                        <Label text="Available" styleClass="stat-label-white"/>
                    </VBox>
                    <VBox styleClass="stat-card-orange" spacing="6" alignment="CENTER_LEFT"
                          HBox.hgrow="ALWAYS">
                        <Label text="💰" style="-fx-font-size: 26px;"/>
                        <Label fx:id="totalRevenueLabel" text="—" styleClass="stat-value-white"/>
                        <Label text="Total Revenue" styleClass="stat-label-white"/>
                    </VBox>
                    <VBox styleClass="stat-card-purple" spacing="6" alignment="CENTER_LEFT"
                          HBox.hgrow="ALWAYS">
                        <Label text="📋" style="-fx-font-size: 26px;"/>
                        <Label fx:id="totalReportsLabel" text="—" styleClass="stat-value-white"/>
                        <Label text="Reports Generated" styleClass="stat-label-white"/>
                    </VBox>
                </HBox>

                <!-- Generate Report Cards -->
                <VBox styleClass="card" spacing="14">
                    <Label text="Generate Reports" styleClass="section-title"/>
                    <HBox spacing="14" alignment="CENTER_LEFT">
                        <!-- Vehicle Inventory -->
                        <Button onAction="#handleGenerateVehicleReport"
                                styleClass="report-card-vehicle"
                                minWidth="150" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <graphic>
                                <VBox spacing="4" alignment="CENTER" style="-fx-padding: 4 0 4 0;">
                                    <Label text="🚘" style="-fx-font-size: 28px;"/>
                                    <Label text="Vehicle Inventory" styleClass="report-btn-label"/>
                                    <Label text="Fleet status report" styleClass="report-btn-sub"/>
                                </VBox>
                            </graphic>
                        </Button>
                        <!-- Daily -->
                        <Button onAction="#handleGenerateDailyReport"
                                styleClass="report-card-daily"
                                minWidth="130" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <graphic>
                                <VBox spacing="4" alignment="CENTER" style="-fx-padding: 4 0 4 0;">
                                    <Label text="📅" style="-fx-font-size: 28px;"/>
                                    <Label text="Daily Report" styleClass="report-btn-label"/>
                                    <Label text="Today's activity" styleClass="report-btn-sub"/>
                                </VBox>
                            </graphic>
                        </Button>
                        <!-- Weekly -->
                        <Button onAction="#handleGenerateWeeklyReport"
                                styleClass="report-card-weekly"
                                minWidth="130" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <graphic>
                                <VBox spacing="4" alignment="CENTER" style="-fx-padding: 4 0 4 0;">
                                    <Label text="📆" style="-fx-font-size: 28px;"/>
                                    <Label text="Weekly Report" styleClass="report-btn-label"/>
                                    <Label text="7-day overview" styleClass="report-btn-sub"/>
                                </VBox>
                            </graphic>
                        </Button>
                        <!-- Monthly -->
                        <Button onAction="#handleGenerateMonthlyReport"
                                styleClass="report-card-monthly"
                                minWidth="130" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <graphic>
                                <VBox spacing="4" alignment="CENTER" style="-fx-padding: 4 0 4 0;">
                                    <Label text="🗓" style="-fx-font-size: 28px;"/>
                                    <Label text="Monthly Report" styleClass="report-btn-label"/>
                                    <Label text="30-day summary" styleClass="report-btn-sub"/>
                                </VBox>
                            </graphic>
                        </Button>
                    </HBox>
                    <Label fx:id="vehicleStatsLabel" text="" styleClass="text-muted" wrapText="true"
                           style="-fx-padding: 4 0 0 0;"/>
                </VBox>

                <Label fx:id="statusLabel" text="" styleClass="text-muted"/>

                <!-- Reports Table -->
                <VBox styleClass="card" spacing="0">
                    <Label text="📋 Report History" styleClass="section-title"
                           style="-fx-padding: 0 0 12 0;"/>
                    <TableView fx:id="reportsTable" minHeight="350" maxWidth="Infinity"
                               styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="typeCol" text="Report Type" minWidth="150"/>
                            <TableColumn fx:id="titleCol" text="Title" minWidth="260"/>
                            <TableColumn fx:id="totalTxnCol" text="Transactions" minWidth="110"/>
                            <TableColumn fx:id="revenueCol" text="Revenue" minWidth="130"/>
                            <TableColumn fx:id="generatedAtCol" text="Generated At" minWidth="170"/>
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="10" style="-fx-padding: 40;">
                                <Label text="📊" style="-fx-font-size: 40px;"/>
                                <Label text="No reports yet. Generate one above!" styleClass="text-muted"
                                       style="-fx-font-size: 15px;"/>
                            </VBox>
                        </placeholder>
                    </TableView>
                </VBox>

                <Button text="← Back to Dashboard" onAction="#goToDashboard" styleClass="btn-outline"/>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
