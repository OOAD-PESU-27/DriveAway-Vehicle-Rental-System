<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.*?>

<VBox spacing="15" alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.driveaway.controllers.VehicleController"
      style="-fx-background-color: #ecf0f1; -fx-padding: 20;">

    <Label text="🚘 Available Vehicles"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <ListView fx:id="vehicleListView" prefHeight="200" prefWidth="350"/>

    <Label fx:id="statusLabel" style="-fx-text-fill: #555;"/>

    <Button text="Refresh"
            onAction="#handleRefresh"
            style="-fx-background-color: #3498db; -fx-text-fill: white;"/>

    <Button text="Book Selected"
            onAction="#handleBook"
            style="-fx-background-color: #e67e22; -fx-text-fill: white;"/>

</VBox>