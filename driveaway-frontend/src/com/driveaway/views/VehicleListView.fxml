<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.driveaway.controllers.VehicleController"
            stylesheets="@styles/main.css"
            styleClass="main-background">

    <top>
        <HBox styleClass="nav-bar" alignment="CENTER_LEFT" spacing="10">
            <VBox alignment="CENTER_LEFT">
                <Label text="🚗 DriveAway" styleClass="nav-logo"/>
                <Label text="Vehicle Rental System" styleClass="nav-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="🏠 Home" onAction="#goToDashboard" styleClass="nav-button"/>
            <Button text="🚘 Vehicles" styleClass="nav-button, nav-button-active"/>
            <Button text="📅 Bookings" onAction="#goToBookings" styleClass="nav-button"/>
            <Separator orientation="VERTICAL"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="nav-logout-button"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="16" style="-fx-padding: 24;">
            <Label text="🚘 Available Vehicles" styleClass="page-title"/>
            <Label fx:id="statusLabel" styleClass="text-muted"/>
            <ListView fx:id="vehicleListView" VBox.vgrow="ALWAYS" styleClass="table-view"/>
            <HBox spacing="12">
                <Button text="🔄 Refresh" onAction="#handleRefresh" styleClass="btn-outline"/>
                <Button text="Book Selected" onAction="#handleBook" styleClass="btn-secondary"/>
                <Button text="📋 Catalog View" onAction="#goToCatalog" styleClass="btn-primary"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>