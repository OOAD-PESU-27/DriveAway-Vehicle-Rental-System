<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ScrollPane?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.driveaway.controllers.VehicleController"
      spacing="20"
      styleClass="main-background">

    <!-- Title -->
    <Label text="Available Vehicles"
           styleClass="page-title"/>
    <!-- Subtitle -->
    <Label text="Choose the best vehicle for your journey"
           styleClass="page-subtitle"/>

    <!-- Search Section -->
    <HBox spacing="15">
        <DatePicker fx:id="startDate" styleClass="date-picker"/>
        <DatePicker fx:id="endDate" styleClass="date-picker"/>
        <Button text="Find Vehicles"
                onAction="#handleSearch"
                styleClass="btn-primary"/>
    </HBox>

    <!-- Vehicle Cards -->
    <ScrollPane fitToWidth="true">
        <content>
            <FlowPane fx:id="vehicleContainer"
                      hgap="20"
                      vgap="20"
                      prefWrapLength="800"/>
        </content>
    </ScrollPane>
</VBox>