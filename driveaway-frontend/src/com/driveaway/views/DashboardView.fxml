<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.driveaway.controllers.DashboardController"
            stylesheets="@styles/main.css"
            styleClass="main-background">

    <!-- TOP NAVIGATION BAR -->
    <top>
        <HBox styleClass="nav-bar" alignment="CENTER_LEFT" spacing="10">
            <VBox alignment="CENTER_LEFT">
                <Label text="🚗 DriveAway" styleClass="nav-logo"/>
                <Label text="Vehicle Rental System" styleClass="nav-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="🏠 Home" onAction="#goToDashboard" styleClass="nav-button, nav-button-active"/>
            <Button text="🚘 Vehicles" onAction="#goToVehicles" styleClass="nav-button"/>
            <Button text="📅 Bookings" onAction="#goToBookings" styleClass="nav-button"/>
            <Button text="👤 Profile" onAction="#goToProfile" styleClass="nav-button"/>
            <Button text="💳 Payment" onAction="#goToPayment" styleClass="nav-button"/>
            <Button text="🔔 Notifications" onAction="#goToNotifications" styleClass="nav-button"/>
            <Button text="📊 Reports" onAction="#goToReports" styleClass="nav-button"/>
            <Button text="⚙️ Admin" onAction="#goToAdminDashboard" styleClass="nav-button"/>
            <Separator orientation="VERTICAL"/>
            <Label fx:id="userNameLabel" text="Welcome!" styleClass="nav-user-label"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="nav-logout-button"/>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="24" style="-fx-padding: 28 32 28 32;">

                <!-- Hero Banner -->
                <VBox styleClass="hero-banner" spacing="8">
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label styleClass="hero-title"
                                   text="🚗 Welcome to DriveAway!"/>
                            <Label styleClass="hero-subtitle"
                                   text="India's most trusted vehicle rental platform — Sedans, SUVs, Luxury &amp; more."/>
                            <HBox spacing="12" style="-fx-padding: 8 0 0 0;">
                                <Button text="🔍 Browse Vehicles" onAction="#goToVehicles"
                                        style="-fx-background-color: white; -fx-text-fill: #1d4ed8;
                                               -fx-font-weight: bold; -fx-background-radius: 8;
                                               -fx-padding: 8 18 8 18; -fx-cursor: hand;"/>
                                <Button text="📅 My Bookings" onAction="#goToBookings"
                                        style="-fx-background-color: rgba(255,255,255,0.18);
                                               -fx-text-fill: white; -fx-font-weight: bold;
                                               -fx-background-radius: 8; -fx-padding: 8 18 8 18;
                                               -fx-border-color: rgba(255,255,255,0.5);
                                               -fx-border-radius: 8; -fx-border-width: 1;
                                               -fx-cursor: hand;"/>
                            </HBox>
                        </VBox>
                        <Label styleClass="hero-emoji-row"
                               text="🚗 🚙 🏎 🚐 🚛"
                               wrapText="false"
                               style="-fx-font-size: 30px;"/>
                    </HBox>
                </VBox>

                <!-- Page Header -->
                <VBox spacing="4">
                    <Label text="Dashboard" styleClass="page-title"/>
                    <Label fx:id="welcomeLabel" text="Welcome back! Here's your rental overview."
                           styleClass="page-subtitle"/>
                </VBox>

                <!-- Stats Row -->
                <HBox spacing="16" alignment="CENTER_LEFT">

                    <VBox styleClass="stat-card" spacing="6" alignment="CENTER_LEFT"
                          HBox.hgrow="ALWAYS">
                        <Label text="📋" style="-fx-font-size: 28px;"/>
                        <Label fx:id="totalBookingsLabel" text="0" styleClass="stat-value"/>
                        <Label text="Total Bookings" styleClass="stat-label"/>
                    </VBox>

                    <VBox styleClass="stat-card" spacing="6" alignment="CENTER_LEFT"
                          HBox.hgrow="ALWAYS">
                        <Label text="✅" style="-fx-font-size: 28px;"/>
                        <Label fx:id="activeBookingsLabel" text="0" styleClass="stat-value"
                               style="-fx-text-fill: #16a34a;"/>
                        <Label text="Active Bookings" styleClass="stat-label"/>
                    </VBox>

                    <VBox styleClass="stat-card" spacing="6" alignment="CENTER_LEFT"
                          HBox.hgrow="ALWAYS">
                        <Label text="🚘" style="-fx-font-size: 28px;"/>
                        <Label fx:id="vehiclesLabel" text="0" styleClass="stat-value"
                               style="-fx-text-fill: #f97316;"/>
                        <Label text="Available Vehicles" styleClass="stat-label"/>
                    </VBox>

                    <VBox styleClass="stat-card" spacing="6" alignment="CENTER_LEFT"
                          HBox.hgrow="ALWAYS">
                        <Label text="💰" style="-fx-font-size: 28px;"/>
                        <Label fx:id="totalSpentLabel" text="₹0" styleClass="stat-value"
                               style="-fx-text-fill: #9333ea;"/>
                        <Label text="Total Spent" styleClass="stat-label"/>
                    </VBox>

                </HBox>

                <!-- Quick Actions -->
                <VBox styleClass="card" spacing="16">
                    <Label text="Quick Actions" styleClass="section-title"/>
                    <HBox spacing="12">
                        <Button text="🚘  Browse Vehicles" onAction="#goToVehicles"
                                styleClass="btn-primary"/>
                        <Button text="📅  My Bookings" onAction="#goToBookings"
                                styleClass="btn-secondary"/>
                        <Button text="👤  My Profile" onAction="#goToProfile"
                                styleClass="btn-outline"/>
                        <Button text="💳  Pay" onAction="#goToPayment"
                                styleClass="btn-outline"/>
                        <Button text="🔔  Notifications" onAction="#goToNotifications"
                                styleClass="btn-outline"/>
                        <Button text="📊  Reports" onAction="#goToReports"
                                styleClass="btn-outline"/>
                    </HBox>
                </VBox>

                <!-- Recent Bookings -->
                <VBox styleClass="card" spacing="16">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Recent Bookings" styleClass="section-title"
                               HBox.hgrow="ALWAYS"/>
                        <Button text="View All →" onAction="#goToBookings"
                                styleClass="btn-outline, btn-small"/>
                    </HBox>

                    <TableView fx:id="recentBookingsTable" prefHeight="220"
                               styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="bookingIdCol" text="Booking ID" prefWidth="120"/>
                            <TableColumn fx:id="vehicleCol" text="Vehicle" prefWidth="160"/>
                            <TableColumn fx:id="startDateCol" text="Start Date" prefWidth="110"/>
                            <TableColumn fx:id="endDateCol" text="End Date" prefWidth="110"/>
                            <TableColumn fx:id="statusCol" text="Status" prefWidth="100"/>
                            <TableColumn fx:id="amountCol" text="Amount" prefWidth="100"/>
                        </columns>
                        <placeholder>
                            <Label text="No bookings yet. Start by browsing our vehicles!"
                                   styleClass="text-muted"/>
                        </placeholder>
                    </TableView>
                </VBox>

                <!-- Featured Vehicles -->
                <VBox styleClass="card" spacing="16">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Featured Vehicles" styleClass="section-title"
                               HBox.hgrow="ALWAYS"/>
                        <Button text="See All →" onAction="#goToVehicles"
                                styleClass="btn-outline, btn-small"/>
                    </HBox>
                    <HBox fx:id="featuredVehiclesBox" spacing="16" alignment="CENTER_LEFT"/>
                    <Label fx:id="vehiclesStatusLabel" styleClass="text-muted"/>
                </VBox>

                <!-- Status Label -->
                <Label fx:id="statusLabel" styleClass="text-muted" wrapText="true"/>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
