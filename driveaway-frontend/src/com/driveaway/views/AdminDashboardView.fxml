<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.driveaway.controllers.AdminDashboardController"
            stylesheets="@styles/main.css"
            styleClass="main-background">

    <top>
        <HBox styleClass="nav-bar" alignment="CENTER_LEFT" spacing="10">
            <VBox alignment="CENTER_LEFT">
                <Label text="🚗 DriveAway" styleClass="nav-logo"/>
                <Label text="Admin Dashboard" styleClass="nav-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="🏠 Home" onAction="#goToDashboard" styleClass="nav-button"/>
            <Button text="🚘 Vehicles" onAction="#goToVehicles" styleClass="nav-button"/>
            <Button text="📅 Bookings" onAction="#goToBookings" styleClass="nav-button"/>
            <Button text="📊 Reports" onAction="#goToReports" styleClass="nav-button"/>
            <Button text="🔔 Notifications" onAction="#goToNotifications" styleClass="nav-button"/>
            <Separator orientation="VERTICAL"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="nav-logout-button"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="24" style="-fx-padding: 28 32 28 32;">

                <Label text="⚙️ Admin Dashboard" styleClass="page-title"/>
                <Label fx:id="adminIdLabel" text="" styleClass="text-muted"/>

                <!-- Summary cards -->
                <HBox spacing="16">
                    <VBox styleClass="stat-card" spacing="6" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                        <Label text="🚘" style="-fx-font-size: 28px;"/>
                        <Label fx:id="fleetCountLabel" text="0" styleClass="stat-value"/>
                        <Label text="Fleet Vehicles" styleClass="stat-label"/>
                    </VBox>
                    <VBox styleClass="stat-card" spacing="6" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                        <Label text="📊" style="-fx-font-size: 28px;"/>
                        <Label fx:id="reportsCountLabel" text="–" styleClass="stat-value"/>
                        <Label text="Reports" styleClass="stat-label"/>
                    </VBox>
                    <VBox styleClass="stat-card" spacing="6" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                        <Button text="📊 View Reports" onAction="#goToReports"
                                styleClass="btn-primary" maxWidth="Infinity"/>
                        <Button text="🔔 View Notifications" onAction="#goToNotifications"
                                styleClass="btn-outline" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <!-- Fleet management -->
                <VBox styleClass="card" spacing="12">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="🚘 Fleet Management" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                        <Button text="🔄 Refresh" onAction="#handleRefreshFleet" styleClass="btn-outline, btn-small"/>
                    </HBox>
                    <Separator/>
                    <Label fx:id="statusLabel" text="" styleClass="text-muted"/>
                    <TableView fx:id="fleetTable" minHeight="300" maxWidth="Infinity">
                        <columns>
                            <TableColumn fx:id="brandCol" text="Brand" minWidth="100"/>
                            <TableColumn fx:id="modelCol" text="Model" minWidth="120"/>
                            <TableColumn fx:id="typeCol" text="Type" minWidth="100"/>
                            <TableColumn fx:id="priceCol" text="Price/Day" minWidth="100"/>
                            <TableColumn fx:id="statusCol" text="Status" minWidth="100"/>
                        </columns>
                        <placeholder>
                            <Label text="No vehicles found." styleClass="text-muted"/>
                        </placeholder>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
