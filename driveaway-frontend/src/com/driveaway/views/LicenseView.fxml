<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.driveaway.controllers.LicenseController"
           stylesheets="@styles/main.css"
           styleClass="login-container">

    <VBox alignment="CENTER" spacing="0" maxWidth="420"
          styleClass="login-card">

        <Label text="🪪" styleClass="login-logo" alignment="CENTER"
               maxWidth="Infinity"/>
        <Label text="Driving License" styleClass="login-title" alignment="CENTER"
               maxWidth="Infinity">
            <VBox.margin><Insets top="8"/></VBox.margin>
        </Label>
        <Label text="Please verify your driving license to continue"
               styleClass="login-subtitle" alignment="CENTER"
               maxWidth="Infinity" wrapText="true">
            <VBox.margin><Insets bottom="28"/></VBox.margin>
        </Label>

        <Label text="License Number" styleClass="form-label" maxWidth="Infinity"/>
        <TextField fx:id="licenseField" promptText="DL-1234567890123"
                   styleClass="form-field" maxWidth="Infinity">
            <VBox.margin><Insets top="4" bottom="14"/></VBox.margin>
        </TextField>

        <Label text="Expiry Date" styleClass="form-label" maxWidth="Infinity"/>
        <DatePicker fx:id="expiryDatePicker" promptText="Select Expiry Date"
                    styleClass="form-field" maxWidth="Infinity" editable="false">
            <VBox.margin><Insets top="4" bottom="6"/></VBox.margin>
        </DatePicker>

        <Label fx:id="statusLabel" styleClass="text-danger" maxWidth="Infinity"
               wrapText="true">
            <VBox.margin><Insets bottom="8"/></VBox.margin>
        </Label>

        <Button text="Verify &amp; Continue" onAction="#handleSubmit"
                styleClass="btn-primary" maxWidth="Infinity">
            <VBox.margin><Insets top="8"/></VBox.margin>
        </Button>

    </VBox>

</StackPane>